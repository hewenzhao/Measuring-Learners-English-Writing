{
  "name": "react-example",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "electron:start": "npm run build && electron .",
    "build:exe": "npm run build && electron-builder --win",
    "build:exe:dir": "npm run build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.measuringlearnersenglishwriting.app",
    "productName": "Measuring Learners English Writing",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "dir"
      ],
      "icon": "public/favicon.ico"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "package.json"
    ]
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "compromise": "^14.15.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.6",
    "autoprefixer": "^10.4.21",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "pdfkit": "^0.20.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
